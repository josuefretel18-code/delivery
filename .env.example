DATABASE_URL=postgresql://usuario:password@host:puerto/delivery_db?sslmode=require

JWT_SECRET_KEY=coloca_aqui_una_clave_segura

MAPS_API_KEY=coloca_aqui_tu_clave_google_maps

# API de ML (ml/servicio.py). Vacio = modelo local. Local: python ml/servicio.py
ML_API_URL=
# Clave compartida con la API de ML (cabecera X-API-Key)
ML_API_KEY=

# Repartidores disponibles para calcular la carga del modelo ML
REPARTIDORES_DISPONIBLES=2

# Reentrenar el modelo ML en segundo plano al entregar cada pedido (true/false)
REENTRENAMIENTO_AUTOMATICO=true

# Asistentes con LLM (OpenAI). Vacio = asistentes apagados.
OPENAI_API_KEY=
LLM_MODELO=gpt-5-mini
# Presupuesto mensual en USD y cortes (primero admin, luego cliente)
LLM_PRESUPUESTO_USD=10
LLM_CORTE_ADMIN_USD=7
LLM_CORTE_CLIENTE_USD=8
# Mensajes por dia y usuario
LLM_MENSAJES_DIARIOS_CLIENTE=15
LLM_MENSAJES_DIARIOS_ADMIN=40
